# Coolify injects DATABASE_URL automatically when you link the Postgres resource.
# For local dev, point it at a local Postgres:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/charm_content_pipeline

# Set to "require" if your Postgres needs SSL (most managed/remote DBs). Leave unset locally.
# PGSSL=require

PORT=3000

# Shared team password that gates the whole app (pages + API). If unset, the app is OPEN.
APP_PASSWORD=changeme
# Strong random secret used to sign the login session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Slack Incoming Webhook for board-update alerts (channel: #marketing-pipeline-updates).
# Create at https://api.slack.com/apps → Incoming Webhooks → point it at the channel.
# If unset, alerts are silently OFF (app still works).
SLACK_WEBHOOK_URL=
# Public app URL used in the "Open the board" link inside each alert.
APP_URL=https://content.hirecharm.com
# How long to coalesce a burst of edits into one digest message (ms). Default 20000.
SLACK_DEBOUNCE_MS=20000
# Weekly Monday 8am Phoenix summary digest. OFF unless set to on/true/1 (paused Aug 2026).
# Per-card alerts (new card, stage move, Leo handoff, script added, blocker) are NOT affected.
WEEKLY_DIGEST=off
